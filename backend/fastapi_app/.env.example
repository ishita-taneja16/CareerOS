# =================================================================
# CareerOS FastAPI Environment Configuration
# =================================================================

PROJECT_NAME="AI Career Copilot Engine"
API_V1_STR="/api/v1"

# Database Configuration
DB_HOST="localhost"
DB_PORT=5432
DB_NAME="aicopilot"
DB_USER="postgres"
DB_PASSWORD="your_password_here"

# Redis
REDIS_URL="redis://localhost:6379/1"

# Chroma Vector Database
CHROMA_HOST="localhost"
CHROMA_PORT=8000

# LLM Providers ("gemini", "openai", "azure", "azure_openai", "foundry", "azure_foundry", "qwen", "ollama", "huggingface")
LLM_PROVIDER="gemini"
LLM_MODEL=""
GEMINI_API_KEY="your_gemini_api_key_here"

# Microsoft Azure OpenAI (Optional)
AZURE_OPENAI_ENDPOINT=""
AZURE_OPENAI_API_KEY=""
AZURE_OPENAI_DEPLOYMENT=""
AZURE_OPENAI_API_VERSION="2024-02-15-preview"

# Microsoft Azure AI Foundry (Optional)
AZURE_FOUNDRY_ENDPOINT=""
AZURE_FOUNDRY_API_KEY=""
AZURE_FOUNDRY_MODEL="Phi-4"

OPENAI_API_KEY="your_openai_api_key_here"
OPENAI_MODEL="gpt-4o-mini"
HUGGINGFACE_API_KEY=""
QWEN_MODEL_PATH="Qwen/Qwen2.5-7B-Instruct"
QWEN_INFERENCE_URL=""

# Langfuse Observability & Tracing
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY="pk-lf-..."
LANGFUSE_SECRET_KEY="sk-lf-..."
LANGFUSE_HOST="https://cloud.langfuse.com"

# Responsible AI Guardrails
ENABLE_RESPONSIBLE_AI_GUARDRAILS=true
BIAS_THRESHOLD=0.15
MAX_HALLUCINATION_SCORE=0.20
